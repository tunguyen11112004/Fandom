APP_NAME=FanHubPlus API (backend temp)
# Prefix tạm, khác frontend — đổi khi tích hợp
API_PREFIX=/api/be/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
EMAIL_VERIFY_HOURS=24
PASSWORD_RESET_MINUTES=30
DATABASE_URL=sqlite:///./fanhubplus.db
# MySQL sau này:
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/fanhubplus
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://127.0.0.1:8000
# console = in link ra terminal (dev). smtp = gửi thật khi cấu hình.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fanhubplus.local
SEED_ADMIN_EMAIL=admin@fanhubplus.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Quan tri vien
