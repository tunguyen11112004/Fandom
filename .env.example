APP_NAME=Fan Hub Plus
API_PREFIX=/api/be/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
EMAIL_VERIFY_HOURS=24
PASSWORD_RESET_MINUTES=30
# Laragon MySQL (empty password by default)
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/fanhubplus
FRONTEND_ORIGIN=http://127.0.0.1:5000
PUBLIC_BASE_URL=http://127.0.0.1:5000
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fanhubplus.local
SEED_ADMIN_EMAIL=admin@fanhubplus.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Fan Hub Admin
# Free key from Google AI Studio. Blank keeps the built-in replies.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
